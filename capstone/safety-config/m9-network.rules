prefix_rule(pattern = [["curl", "wget", "nc", "ncat", "ssh", "scp", "sftp", "rsync", "ftp", "telnet"]],
            decision = "forbidden", justification = "Module 9: no outbound network from the agent.")
prefix_rule(pattern = [["gh", "aws", "az", "gcloud"]],
            decision = "forbidden", justification = "Module 9: no agent access to cloud or GitHub accounts.")
prefix_rule(pattern = ["git", ["remote", "fetch", "pull", "clone"]],
            decision = "prompt", justification = "Module 9: network git operations need review.")
